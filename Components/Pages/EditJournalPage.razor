@page "/journal/edit/{EntryDate:datetime}"
@using JournalApp.Models
@using Markdig
@inject JournalApp.Services.DatabaseService Database
@inject NavigationManager Nav

<style>
    .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 12px
    }

    .top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 12px
    }

    .title {
        margin: 0;
        font-size: 1.5rem;
        color: #111827
    }

    .muted {
        color: #6b7280;
        font-size: .95rem;
        margin-top: 4px
    }

    .pill {
        border: 1px solid #e5e7eb;
        background: #fff;
        padding: 8px 10px;
        border-radius: 999px;
        font-weight: 600;
        color: #374151;
        font-size: .92rem
    }

    .panel {
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 12px;
        padding: 14px
    }

    .field {
        margin-bottom: 10px
    }

        .field label {
            display: block;
            font-weight: 700;
            margin-bottom: 6px;
            color: #111827
        }

    .in, .sel, .ta {
        width: 100%;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
        background: #f9fafb;
        color: #111827
    }

    .ta {
        min-height: 220px;
        resize: vertical
    }

        .in:focus, .sel:focus, .ta:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(147,197,253,.35);
            background: #fff
        }

    .tabs {
        display: flex;
        gap: 8px;
        margin: 10px 0
    }

    .tab {
        border: 1px solid #d1d5db;
        background: #fff;
        border-radius: 10px;
        padding: 8px 10px;
        font-weight: 800;
        cursor: pointer
    }

        .tab.on {
            border-color: #93c5fd;
            background: #eff6ff;
            color: #1d4ed8
        }

    .preview {
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 10px;
        padding: 10px;
        min-height: 220px;
        overflow: auto
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px
    }

    @@media(min-width:900px) {
        .grid {
            grid-template-columns: 1fr 1fr
        }
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px
    }

    .tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border: 1px solid #e5e7eb;
        background: #f3f4f6;
        border-radius: 999px;
        font-size: .92rem
    }

    .row {
        display: flex;
        gap: 8px;
        align-items: center
    }

        .row input {
            flex: 1
        }

    .btn {
        border: 1px solid #d1d5db;
        background: #fff;
        padding: 9px 12px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 800
    }

        .btn:hover {
            background: #f9fafb
        }

    .primary {
        border-color: #93c5fd;
        background: #eff6ff;
        color: #1d4ed8
    }

        .primary:hover {
            background: #dbeafe
        }

    .danger {
        border-color: #fecaca;
        background: #fff1f2;
        color: #b91c1c
    }

        .danger:hover {
            background: #ffe4e6
        }

    .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px
    }
</style>

<div class="wrap">
    <div class="top">
        <div>
            <h3 class="title">Edit Journal</h3>
            <div class="muted">Edit details and update or delete the entry.</div>
        </div>
        <div class="pill">Date: @EntryDate.ToString("yyyy-MM-dd")</div>
    </div>

    @if (Entry == null)
    {
        <div class="panel">
            <b>Loading...</b>
            <div class="muted" style="margin-top:6px;">Fetching entry for this date.</div>
        </div>
    }
    else
    {
        <div class="panel">
            <!-- Title -->
            <div class="field">
                <label>Title</label>
                <input class="in" @bind="Entry.Title" placeholder="Edit title..." />
            </div>

            <!-- Editor/Preview Tabs (different from JournalPage) -->
            <div class="tabs">
                <button type="button" class="tab @(ShowPreview ? "" : "on")" @onclick="() => ShowPreview = false">✍ Editor</button>
                <button type="button" class="tab @(ShowPreview ? "on" : "")" @onclick="() => ShowPreview = true">👁 Preview</button>
            </div>

            @if (!ShowPreview)
            {
                <textarea class="ta"
                          @bind="Entry.Content"
                          @bind:event="oninput"
                          placeholder="Update your content..."></textarea>
                <div class="muted" style="margin-top:6px;">
                    Tip: **bold**, *italic*, # Heading, - List, [link](https://example.com)
                </div>
            }
            else
            {
                <div class="preview">
                    @((MarkupString)Markdown.ToHtml(Entry.Content ?? ""))
                </div>
                <div class="muted" style="margin-top:6px;">Live preview (updates while typing)</div>
            }

            <div class="grid" style="margin-top:12px;">
                <!-- Mood -->
                <div>
                    <div class="field">
                        <label>Primary Mood</label>
                        <select class="sel" @bind="Entry.PrimaryMood">
                            @foreach (var mood in AllMoods)
                            {
                                <option>@mood</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label>Secondary Mood 1</label>
                        <select class="sel" @bind="Entry.SecondaryMood1">
                            <option value="">-- None --</option>
                            @foreach (var mood in AllMoods)
                            {
                                <option>@mood</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label>Secondary Mood 2</label>
                        <select class="sel" @bind="Entry.SecondaryMood2">
                            <option value="">-- None --</option>
                            @foreach (var mood in AllMoods)
                            {
                                <option>@mood</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Tags -->
                <div>
                    <div class="field">
                        <label>Tags</label>
                        <div class="tags">
                            @foreach (var tag in AllVisibleTags)
                            {
                                <label class="tag">
                                    <input type="checkbox"
                                           checked="@SelectedTags.Contains(tag)"
                                           @onchange="(e) => ToggleTag(tag, e.Value)" />
                                    <span>@tag</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="field">
                        <label>Add Custom Tag</label>
                        <div class="row">
                            <input class="in" @bind="NewTag" placeholder="e.g. Exam, Friends" />
                            <button type="button" class="btn" @onclick="AddCustomTag">Add</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="actions">
                <button class="btn primary" @onclick="UpdateEntry">💾 Update</button>
                <button class="btn danger" @onclick="DeleteEntry">🗑 Delete</button>
            </div>

            <div class="muted" style="margin-top:10px;">
                Changes apply to <b>@EntryDate.ToString("yyyy-MM-dd")</b>.
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime EntryDate { get; set; }

    private JournalEntry? Entry;
    private bool ShowPreview = false;

    private HashSet<string> SelectedTags = new(StringComparer.OrdinalIgnoreCase);
    private string? NewTag;

    private readonly List<string> PredefinedTags = new()
    {
        "Work","Studies","Health","Fitness","Travel",
        "Family","Personal Growth","Hobbies","Coding"
    };

    private readonly List<string> AllMoods = new()
    {
        "Happy","Excited","Relaxed","Grateful",
        "Calm","Thoughtful","Bored",
        "Sad","Stressed","Anxious"
    };

    private List<string> AllVisibleTags =>
        PredefinedTags.Union(SelectedTags, StringComparer.OrdinalIgnoreCase)
                      .OrderBy(t => t).ToList();

    protected override async Task OnInitializedAsync()
    {
        var entries = await Database.GetEntriesAsync();
        Entry = entries.FirstOrDefault(e => e.EntryDate == EntryDate);

        if (Entry?.Tags == null) return;

        foreach (var tag in Entry.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
            SelectedTags.Add(tag.Trim());
    }

    private void ToggleTag(string tag, object? value)
    {
        if (value is bool b && b) SelectedTags.Add(tag);
        else SelectedTags.Remove(tag);
    }

    private void AddCustomTag()
    {
        if (string.IsNullOrWhiteSpace(NewTag)) return;
        SelectedTags.Add(NewTag.Trim());
        NewTag = "";
    }

    private async Task UpdateEntry()
    {
        Entry!.Tags = string.Join(",", SelectedTags);
        Entry.UpdatedAt = DateTime.Now;

        await Database.SaveEntryAsync(Entry);
        Nav.NavigateTo("/journals");
    }

    private async Task DeleteEntry()
    {
        await Database.DeleteEntryAsync(Entry!.EntryDate);
        Nav.NavigateTo("/journals");
    }
}
