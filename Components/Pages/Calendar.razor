@page "/calendar"

@using JournalApp.Models
@inject JournalApp.Services.DatabaseService Database
@inject NavigationManager Nav

<h2 class="cal-title">📅 Calendar</h2>

<div class="calendar-header">
    <button class="btn secondary" @onclick="PreviousMonth">‹</button>

    <h3 class="cal-month">@CurrentMonth.ToString("MMMM yyyy")</h3>

    <button class="btn secondary" @onclick="NextMonth">›</button>
</div>

<div class="calendar-grid">
    @foreach (var dayName in DayNames)
    {
        <div class="calendar-day header">@dayName</div>
    }

    @foreach (var day in CalendarDays)
    {
        <div class="calendar-day @(day.HasEntry ? "has-entry" : "")"
             @onclick="() => OpenDay(day.Date)">

            @if (day.Date != null)
            {
                <span class="day-number">@day.Date.Value.Day</span>

                @if (day.HasEntry)
                {
                    <span class="entry-dot"></span>
                }
            }
        </div>
    }
</div>

<style>
    /* ===== Make it look like a real calendar (minimal CSS) ===== */

    .cal-title {
        margin: 6px 0 12px;
    }

    .calendar-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .cal-month {
        margin: 0;
        flex: 1;
        text-align: center;
        font-weight: 700;
    }

    /* ✅ This is the main fix: real 7-column calendar grid */
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 10px;
        max-width: 520px;
    }

    /* cells */
    .calendar-day {
        height: 64px;
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 12px;
        background: #fff;
        padding: 8px;
        position: relative;
        cursor: pointer;
        transition: transform .08s ease, box-shadow .08s ease;
    }

        .calendar-day:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.08);
        }

        /* day-name header row */
        .calendar-day.header {
            height: 34px;
            cursor: default;
            font-weight: 700;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0,0,0,0.04);
        }

    /* day number */
    .day-number {
        font-weight: 700;
    }

    /* dot for entry */
    .entry-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #3b82f6;
        position: absolute;
        bottom: 10px;
        right: 10px;
    }

    /* highlight cells having entry */
    .has-entry {
        border-color: rgba(59,130,246,0.55);
        box-shadow: 0 0 0 2px rgba(59,130,246,0.12) inset;
    }
</style>

@code {
    private DateTime CurrentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<CalendarDay> CalendarDays = new();

    private readonly string[] DayNames =
    {
        "Sun","Mon","Tue","Wed","Thu","Fri","Sat"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadCalendar();
    }

    private async Task LoadCalendar()
    {
        CalendarDays.Clear();

        var entries = await Database.GetEntriesAsync();
        var entryDates = entries.Select(e => e.EntryDate.Date).ToHashSet();

        var firstDayOfMonth = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(CurrentMonth.Year, CurrentMonth.Month);

        int startOffset = (int)firstDayOfMonth.DayOfWeek;

        for (int i = 0; i < startOffset; i++)
            CalendarDays.Add(new CalendarDay());

        for (int day = 1; day <= daysInMonth; day++)
        {
            var date = new DateTime(CurrentMonth.Year, CurrentMonth.Month, day);
            CalendarDays.Add(new CalendarDay { Date = date, HasEntry = entryDates.Contains(date) });
        }
    }

    private async Task PreviousMonth() { CurrentMonth = CurrentMonth.AddMonths(-1); await LoadCalendar(); }
    private async Task NextMonth() { CurrentMonth = CurrentMonth.AddMonths(1); await LoadCalendar(); }

    private void OpenDay(DateTime? date)
    {
        if (date == null) return;
        Nav.NavigateTo($"/journal/edit/{date:yyyy-MM-dd}");
    }

    private class CalendarDay
    {
        public DateTime? Date { get; set; }
        public bool HasEntry { get; set; }
    }
}
