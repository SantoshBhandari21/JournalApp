@page "/"
@using JournalApp.Models
@inject JournalApp.Services.DatabaseService Database

<style>
    .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 12px;
    }

    .header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .title {
        margin: 0;
        font-size: 1.5rem;
        color: #111827;
    }

    .muted {
        color: #6b7280;
        font-size: .95rem;
        margin-top: 4px;
    }

    .pill {
        border: 1px solid #e5e7eb;
        background: #ffffff;
        padding: 8px 10px;
        border-radius: 999px;
        font-weight: 600;
        color: #374151;
        font-size: .92rem;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    @@media (min-width: 900px) {
        .grid {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }

    .card {
        border: 1px solid #e5e7eb;
        background: #ffffff;
        border-radius: 12px;
        padding: 14px;
    }

    .card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .card-label {
        color: #6b7280;
        font-weight: 600;
        font-size: .95rem;
    }

    .card-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: #111827;
        margin: 2px 0 0;
    }

    .badge {
        border: 1px solid #dbeafe;
        background: #eff6ff;
        color: #1d4ed8;
        padding: 6px 10px;
        border-radius: 999px;
        font-weight: 700;
        font-size: .85rem;
        white-space: nowrap;
    }

    .panel {
        margin-top: 12px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        border-radius: 12px;
        padding: 14px;
    }

        .panel h4 {
            margin: 0 0 6px;
            color: #111827;
        }

    .row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .btn {
        border: 1px solid #d1d5db;
        background: #ffffff;
        padding: 9px 12px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 700;
        color: #111827;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn:hover {
            background: #f9fafb;
        }

    .btn-primary {
        border-color: #93c5fd;
        background: #eff6ff;
        color: #1d4ed8;
    }

        .btn-primary:hover {
            background: #dbeafe;
        }
</style>

<div class="wrap">
    <div class="header">
        <div>
            <h3 class="title">Dashboard</h3>
            <div class="muted">Quick overview of your journaling activity.</div>
        </div>

        <div class="pill">Today: @DateTime.Today.ToString("yyyy-MM-dd")</div>
    </div>

    <div class="grid">
        <div class="card">
            <div class="card-top">
                <div class="card-label">Total Entries</div>
            </div>
            <div class="card-value">@TotalEntries</div>
            <div class="muted">Number of journal entries saved.</div>
        </div>

        <div class="card">
            <div class="card-top">
                <div class="card-label">Last Entry Date</div>
            </div>
            <div class="card-value">@LastDate</div>
            <div class="muted">Your latest journal entry date.</div>
        </div>

        <div class="card">
            <div class="card-top">
                <div class="card-label">Most Common Mood</div>
            </div>
            <div class="card-value">@MostCommonMood</div>
            <div class="muted">Based on your saved entries.</div>
        </div>
    </div>

    <div class="panel">
        <h4>Quick Actions</h4>
       

        <div class="row">
            <a class="btn btn-primary" href="/journal">✍ Create Journal Entry</a>
            <a class="btn" href="/journals">📚 View Journal List</a>
        </div>
    </div>
</div>

@code {
    private int TotalEntries;
    private string LastDate = "-";
    private string MostCommonMood = "-";

    protected override async Task OnInitializedAsync()
    {
        var entries = await Database.GetEntriesAsync();
        TotalEntries = entries.Count;

        if (entries.Any())
        {
            LastDate = entries.Max(e => e.EntryDate).ToString("yyyy-MM-dd");
            MostCommonMood = entries
                .GroupBy(e => e.PrimaryMood)
                .OrderByDescending(g => g.Count())
                .First().Key;
        }
    }
}
