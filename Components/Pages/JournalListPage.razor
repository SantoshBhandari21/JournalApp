@page "/journals"

@using JournalApp.Models
@inject JournalApp.Services.DatabaseService Database
@inject NavigationManager Nav

<style>
    .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 12px;
    }

    .header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .title {
        margin: 0;
        font-size: 1.5rem;
        color: #111827;
    }

    .muted {
        color: #6b7280;
        font-size: .95rem;
        margin-top: 4px;
    }

    .pill {
        border: 1px solid #e5e7eb;
        background: #ffffff;
        padding: 8px 10px;
        border-radius: 999px;
        font-weight: 600;
        color: #374151;
        font-size: .92rem;
        white-space: nowrap;
    }

    .panel {
        border: 1px solid #e5e7eb;
        background: #ffffff;
        border-radius: 12px;
        padding: 14px;
    }

    .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .btn {
        border: 1px solid #d1d5db;
        background: #ffffff;
        padding: 9px 12px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 700;
        color: #111827;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn:hover {
            background: #f9fafb;
        }

    .btn-primary {
        border-color: #93c5fd;
        background: #eff6ff;
        color: #1d4ed8;
    }

        .btn-primary:hover {
            background: #dbeafe;
        }

    .btn-danger {
        border-color: #fecaca;
        background: #fff1f2;
        color: #b91c1c;
    }

        .btn-danger:hover {
            background: #ffe4e6;
        }

    .table-wrap {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #f9fafb;
    }

    th, td {
        padding: 10px 12px;
        text-align: left;
        border-bottom: 1px solid #e5e7eb;
    }

    th {
        font-size: .92rem;
        color: #374151;
        font-weight: 800;
    }

    td {
        color: #111827;
    }

    tbody tr:hover {
        background: #fcfcfd;
    }

    .actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .empty {
        border: 1px dashed #d1d5db;
        border-radius: 12px;
        padding: 14px;
        background: #ffffff;
        color: #374151;
    }
</style>

<div class="wrap">
    <div class="header">
        <div>
            <h3 class="title">Journal List</h3>
            <div class="muted">View, edit or delete saved entries.</div>
        </div>

        <div class="pill">Total: @Entries.Count</div>
    </div>

    @if (Entries.Count == 0)
    {
        <div class="empty">
            <b>No journal entries found.</b>
            <div class="muted" style="margin-top:6px;">
                Create your first entry from the Journal page.
            </div>

            <div style="margin-top:10px;">
                <a class="btn btn-primary" href="/journal">✍ Create Entry</a>
            </div>
        </div>
    }
    else
    {
        <div class="panel">
            <div class="toolbar">
                <div class="muted">Showing newest first</div>
                <a class="btn btn-primary" href="/journal">✍ New Entry</a>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 160px;">Date</th>
                            <th>Title</th>
                            <th style="width: 220px; text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Entries)
                        {
                            <tr>
                                <td>@entry.EntryDate.ToString("yyyy-MM-dd")</td>
                                <td>@(string.IsNullOrWhiteSpace(entry.Title) ? "(No title)" : entry.Title)</td>
                                <td>
                                    <div class="actions">
                                        <button class="btn"
                                                @onclick="() => EditEntry(entry.EntryDate)">
                                            ✏ Edit
                                        </button>

                                        <button class="btn btn-danger"
                                                @onclick="() => DeleteEntry(entry.EntryDate)">
                                            🗑 Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="muted" style="margin-top:10px;">
            </div>
        </div>
    }
</div>

@code {
    private List<JournalEntry> Entries = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        Entries = await Database.GetEntriesAsync();
        Entries = Entries
            .OrderByDescending(e => e.EntryDate)
            .ToList();
    }

    private void EditEntry(DateTime entryDate)
    {
        // Navigate to dedicated edit page
        Nav.NavigateTo($"/journal/edit/{entryDate:yyyy-MM-dd}");
    }

    private async Task DeleteEntry(DateTime entryDate)
    {
        await Database.DeleteEntryAsync(entryDate);
        await LoadEntries();
    }
}
