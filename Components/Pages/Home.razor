@page "/"
@page "/home"

@using JournalApp.Models
@inject JournalApp.Services.DatabaseService Database

<!-- Dashboard header and date range filter -->
<div class="page">
    <div class="head">
        <div>
            <h2 class="title">Dashboard Analytics</h2>
            <p class="sub">Summary insights based on your journal entries.</p>
        </div>

        <div class="filter">
            <label class="muted" for="range">Date Range</label>
            <select id="range" class="input" @bind="SelectedRange" @bind:after="LoadAnalytics">
                <option value="All">All Time</option>
                <option value="7">Last 7 Days</option>
                <option value="30">Last 30 Days</option>
            </select>
        </div>
    </div>

    <!-- Summary stats -->
    <div class="stats">
        <div class="stat">
            <div class="k">Total Entries</div>
            <div class="v">@TotalEntries</div>
        </div>

        <div class="stat accent">
            <div class="k">Current Streak</div>
            <div class="v">@CurrentStreak</div>
        </div>

        <div class="stat">
            <div class="k">Longest Streak</div>
            <div class="v">@LongestStreak</div>
        </div>

        <div class="stat">
            <div class="k">Missed Days</div>
            <div class="v">@MissedDays</div>
        </div>

        <div class="stat">
            <div class="k">Most Frequent Mood</div>
            <div class="v">@MostCommonMood</div>
        </div>
    </div>

    <!-- Mood distribution and tag usage -->
    <div class="card">
        <h3 class="sec">Mood Distribution</h3>

        @if (!MoodDistribution.Any())
        {
            <p class="muted">No data available for the selected range.</p>
        }
        else
        {
            @foreach (var mood in MoodDistribution)
            {
                <div class="bar-row">
                    <span class="lbl">@mood.Key</span>
                    <div class="bar"><div class="fill" style="width:@mood.Value%"></div></div>
                    <span class="pct">@mood.Value%</span>
                </div>
            }
        }
    </div>

    <div class="card" style="margin-top:14px;">
        <h3 class="sec">Most Used Tags</h3>

        @if (!MostUsedTags.Any())
        {
            <p class="muted">No tag usage found for the selected range.</p>
        }
        else
        {
            @foreach (var tag in MostUsedTags)
            {
                <div class="bar-row">
                    <span class="lbl">@tag.Key</span>
                    <div class="bar"><div class="fill" style="width:@tag.Value%"></div></div>
                    <span class="pct">@tag.Value%</span>
                </div>
            }
        }
    </div>

    <!-- Word count -->
    <div class="card" style="margin-top:14px;">
        <h3 class="sec">Word Count Trend</h3>
        <p class="muted" style="margin:0;">Average words per entry: <b>@AverageWordCount</b></p>
    </div>
</div>

<style>
/* Page layout */
.page{max-width:1050px;margin:0 auto;padding:22px 22px 34px;color:#0f172a}
.head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin:6px 0 16px}
.title{margin:0;font-size:26px;font-weight:800;letter-spacing:.2px}
.sub{margin:6px 0 0;color:#475569;font-weight:600}
.muted{color:#475569}

/* Filter */
.filter{display:flex;flex-direction:column;gap:6px}
.input{
    border:1px solid #e2e8f0;background:#fff;color:#0f172a;border-radius:12px;
    padding:9px 12px;outline:none;min-width:170px;
    box-shadow:0 6px 18px rgba(15,23,42,.06)
}

/* Cards and summary stats */
.card{
    background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:16px;
    box-shadow:0 14px 34px rgba(15,23,42,.10)
}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.stat{
    background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:14px 16px;
    box-shadow:0 10px 26px rgba(15,23,42,.08)
}
.stat.accent{
    border-color:rgba(59,130,246,.45);
    box-shadow:0 0 0 3px rgba(59,130,246,.12) inset, 0 10px 26px rgba(15,23,42,.08)
}
.k{font-size:12px;font-weight:800;color:#64748b;margin-bottom:6px;letter-spacing:.3px;text-transform:uppercase}
.v{font-size:26px;font-weight:900;color:#0f172a}
.sec{margin:0 0 12px;font-weight:900;letter-spacing:.2px}

/* Bars */
.bar-row{display:grid;grid-template-columns:160px 1fr 60px;gap:12px;align-items:center;padding:6px 0}
.lbl{color:#0f172a;font-weight:700}
.pct{color:#64748b;text-align:right;font-weight:800}
.bar{height:12px;border-radius:999px;background:#f1f5f9;border:1px solid #e2e8f0;overflow:hidden}
.fill{height:100%;background:#3b82f6;border-radius:999px}

@@media (max-width: 800px){
    .head{flex-direction:column;align-items:stretch}
    .filter{align-items:stretch}
    .input{min-width:100%}
    .bar-row{grid-template-columns:120px 1fr 50px}
}
</style>

@code {
    private string SelectedRange = "All";

    private int TotalEntries;
    private int CurrentStreak;
    private int LongestStreak;
    private int MissedDays;
    private int AverageWordCount;
    private string MostCommonMood = "-";
    

    private Dictionary<string, int> MoodDistribution = new();
    private Dictionary<string, int> MostUsedTags = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalytics();
    }

    /* Loading entries, appliying filters and prepare values for the dashboard */
    private async Task LoadAnalytics()
    {
        ResetAnalytics();

        var entries = await Database.GetEntriesAsync();

        if (SelectedRange != "All")
        {
            int days = int.Parse(SelectedRange);
            var fromDate = DateTime.Today.AddDays(-days);
            entries = entries.Where(e => e.EntryDate >= fromDate).ToList();
        }

        if (!entries.Any())
            return;

        TotalEntries = entries.Count;

        var moods = entries.Where(e => !string.IsNullOrWhiteSpace(e.PrimaryMood)).ToList();
        if (moods.Any())
        {
            MostCommonMood = moods
                .GroupBy(e => e.PrimaryMood)
                .OrderByDescending(g => g.Count())
                .First().Key;
        }

        MoodDistribution = entries
            .GroupBy(e => GetMoodCategory(e.PrimaryMood))
            .ToDictionary(
                g => g.Key,
                g => (int)(g.Count() * 100.0 / entries.Count)
            );

        var tags = entries
            .Where(e => !string.IsNullOrWhiteSpace(e.Tags))
            .SelectMany(e => e.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
            .Select(t => t.Trim())
            .Where(t => t.Length > 0)
            .ToList();

        if (tags.Count > 0)
        {
            MostUsedTags = tags
                .GroupBy(t => t)
                .OrderByDescending(g => g.Count())
                .Take(5)
                .ToDictionary(
                    g => g.Key,
                    g => (int)(g.Count() * 100.0 / tags.Count)
                );
        }

        AverageWordCount = (int)entries.Average(e =>
            string.IsNullOrWhiteSpace(e.Content)
                ? 0
                : e.Content.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length
        );

        CalculateStreaks(entries.Select(e => e.EntryDate.Date).Distinct().OrderBy(d => d).ToList());
    }

    /* Resets all analytics */
    private void ResetAnalytics()
    {
        TotalEntries = 0;
        CurrentStreak = 0;
        LongestStreak = 0;
        MissedDays = 0;
        MostCommonMood = "-";
        AverageWordCount = 0;
        MoodDistribution = new();
        MostUsedTags = new();
    }

    /* Calculates current streak, longest streak and missed days */
    private void CalculateStreaks(List<DateTime> dates)
    {
        if (dates.Count == 0)
            return;

        DateTime today = DateTime.Today;

        int current = 0;
        DateTime cursor = today;
        while (dates.Contains(cursor))
        {
            current++;
            cursor = cursor.AddDays(-1);
        }
        CurrentStreak = current;

        int longest = 1, temp = 1;
        for (int i = 1; i < dates.Count; i++)
        {
            if (dates[i] == dates[i - 1].AddDays(1)) temp++;
            else { longest = Math.Max(longest, temp); temp = 1; }
        }
        LongestStreak = Math.Max(longest, temp);

        MissedDays = Enumerable
            .Range(0, (today - dates.First()).Days + 1)
            .Count(i => !dates.Contains(dates.First().AddDays(i)));
    }

    private string GetMoodCategory(string mood)
    {
        return mood switch
        {
            "Happy" or "Excited" or "Relaxed" or "Grateful" or "Confident" => "Positive",
            "Calm" or "Thoughtful" or "Curious" or "Nostalgic" or "Bored" => "Neutral",
            _ => "Negative"
        };
    }
}
