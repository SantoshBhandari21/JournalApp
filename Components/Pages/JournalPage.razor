@page "/journal"

@using JournalApp.Models
@using Markdig
@inject JournalApp.Services.DatabaseService Database

<style>
    /* Lightweight, clean look */
    .wrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 12px;
    }

    .header {
        margin-bottom: 12px;
    }

        .header h3 {
            margin: 0;
            font-size: 1.45rem;
        }

    .muted {
        color: #6b7280;
        font-size: .95rem;
        margin-top: 4px;
    }

    .panel {
        border: 1px solid #e5e7eb;
        background: #ffffff;
        border-radius: 12px;
        padding: 14px;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    @@media (min-width: 900px) {
        .grid {
            grid-template-columns: 1.2fr .8fr;
        }
    }

    .field {
        margin-bottom: 10px;
    }

        .field label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
            color: #111827;
        }

    .input, .select, .textarea {
        width: 100%;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
        background: #f9fafb;
        color: #111827;
    }

    .textarea {
        min-height: 200px;
        resize: vertical;
    }

        .input:focus, .select:focus, .textarea:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(147, 197, 253, 0.35);
            background: #ffffff;
        }

    .split {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    @@media (min-width: 900px) {
        .split {
            grid-template-columns: 1fr 1fr;
        }
    }

    .preview {
        border: 1px solid #e5e7eb;
        background: #ffffff;
        border-radius: 10px;
        padding: 10px;
        min-height: 200px;
        overflow: auto;
    }

    .section-title {
        margin: 12px 0 8px;
        font-weight: 700;
        color: #111827;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border: 1px solid #e5e7eb;
        background: #f3f4f6;
        border-radius: 999px;
        font-size: .92rem;
        color: #111827;
    }

    .row {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .row input {
            flex: 1;
        }

    .btn {
        border: 1px solid #d1d5db;
        background: #ffffff;
        padding: 9px 12px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
        color: #111827;
    }

        .btn:hover {
            background: #f9fafb;
        }

    .btn-primary {
        border-color: #93c5fd;
        background: #eff6ff;
    }

        .btn-primary:hover {
            background: #dbeafe;
        }

    .status {
        margin-top: 10px;
        font-weight: 600;
    }

    .ok {
        color: #15803d;
    }
    /* green */
    .warn {
        color: #b45309;
    }
    /* amber */
</style>

<div class="wrap">
    <div class="header">
        <h3>Journal Entry</h3>
        <div class="muted">Write your entry, select your mood and add tags.</div>
    </div>

    <div class="grid">
        <!-- LEFT: Title + Editor + Preview -->
        <div class="panel">
            <div class="field">
                <label>Title</label>
                <input class="input" placeholder="Title..." @bind="Title" />
            </div>

            <div class="section-title">Content (Markdown)</div>

            <div class="split">
                <div>
                    <textarea class="textarea"
                              placeholder="Write here..."
                              @bind="Content"
                              @bind:event="oninput"></textarea>
                    <div class="muted">Tip: **bold**, *italic*, # Heading, - List, link=(https://....com)</div>
                </div>

                <div>
                    <div class="preview">
                        @((MarkupString)MarkdownPreview)
                    </div>
                    <div class="muted">Live Preview</div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Mood + Tags + Save -->
        <div class="panel">
            <div class="section-title">Mood Tracking</div>

            <div class="field">
                <label>Primary Mood (Required)</label>
                <select class="select" @bind="PrimaryMood">
                    <option value="">-- Select Primary Mood --</option>
                    @foreach (var mood in AllMoods)
                    {
                        <option>@mood</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Secondary Mood 1</label>
                <select class="select" @bind="SecondaryMood1">
                    <option value="">-- None --</option>
                    @foreach (var mood in AllMoods)
                    {
                        <option>@mood</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Secondary Mood 2</label>
                <select class="select" @bind="SecondaryMood2">
                    <option value="">-- None --</option>
                    @foreach (var mood in AllMoods)
                    {
                        <option>@mood</option>
                    }
                </select>
            </div>

            <div class="section-title">Tags</div>

            <div class="tags">
                @foreach (var tag in AllVisibleTags)
                {
                    <label class="tag">
                        <input type="checkbox"
                               checked="@SelectedTags.Contains(tag)"
                               @onchange="(e) => ToggleTag(tag, e.Value)" />
                        <span>@tag</span>
                    </label>
                }
            </div>

            <div class="section-title">Add Custom Tag</div>

            <div class="row">
                <input class="input" placeholder="e.g. Music" @bind="NewTag" />
                <button type="button" class="btn" @onclick="AddCustomTag">Add</button>
            </div>

            <div style="margin-top: 12px;">
                <button class="btn btn-primary" @onclick="SaveEntry">Save Journal Entry</button>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="status @(Message.Contains("required", StringComparison.OrdinalIgnoreCase) ? "warn" : "ok")">
                        @Message
                    </div>
                }
            </div>

            <div class="muted" style="margin-top:10px;">
                Saved date: <b>@DateTime.Today.ToString("yyyy-MM-dd")</b>
            </div>
        </div>
    </div>
</div>

@code {
    private string? Title;
    private string? Content;

    private string PrimaryMood = "";
    private string? SecondaryMood1;
    private string? SecondaryMood2;

    private HashSet<string> SelectedTags =
        new(StringComparer.OrdinalIgnoreCase);

    private string? NewTag;
    private string Message = "";

    private readonly List<string> AllMoods = new()
    {
        "Happy","Excited","Relaxed","Grateful",
        "Calm","Thoughtful","Bored",
        "Sad","Stressed","Anxious"
    };

    private readonly List<string> PredefinedTags = new()
    {
        "Work","Studies","Health","Fitness","Travel",
        "Family","Personal Growth","Hobbies","Coding"
    };

    private List<string> AllVisibleTags =>
        PredefinedTags
            .Union(SelectedTags, StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t)
            .ToList();

    private string MarkdownPreview =>
        Markdown.ToHtml(Content ?? "");

    private void ToggleTag(string tag, object? value)
    {
        if (value is bool b && b)
            SelectedTags.Add(tag);
        else
            SelectedTags.Remove(tag);
    }

    private void AddCustomTag()
    {
        if (string.IsNullOrWhiteSpace(NewTag))
            return;

        SelectedTags.Add(NewTag.Trim());
        NewTag = "";
    }

    private async Task SaveEntry()
    {
        if (string.IsNullOrWhiteSpace(PrimaryMood))
        {
            Message = "Primary mood is required.";
            return;
        }

        var entry = new JournalEntry
        {
            EntryDate = DateTime.Today,
            Title = Title,
            Content = Content,
            PrimaryMood = PrimaryMood,
            SecondaryMood1 = SecondaryMood1,
            SecondaryMood2 = SecondaryMood2,
            Tags = string.Join(",", SelectedTags),
            CreatedAt = DateTime.Now,
            UpdatedAt = DateTime.Now
        };

        await Database.SaveEntryAsync(entry);

        Message = "Today's journal entry saved successfully.";

        Title = Content = null;
        PrimaryMood = "";
        SecondaryMood1 = SecondaryMood2 = null;
        SelectedTags.Clear();
    }
}
