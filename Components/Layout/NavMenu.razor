@inject IJSRuntime JS

<!-- Main sidebar navigation -->
<nav class="sidebar">
    <h2 class="logo">JournalApp</h2>

    <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">Home</NavLink>
    <NavLink href="/journal" class="nav-item">Add Journal</NavLink>
    <NavLink href="/journals" class="nav-item">View Journal</NavLink>
    <NavLink href="/calendar" class="nav-item">Calendar</NavLink>
    <NavLink href="/settings" class="nav-item">Settings</NavLink>

    <div class="theme-toggle">
        <span class="theme-text">Theme</span>
        <button class="btn-theme" type="button" @onclick="ToggleTheme">
            @(IsDarkTheme ? "Light" : "Dark")
        </button>
    </div>
</nav>

<style>
    .sidebar {
        width: 220px;
        height: 100vh;
        background-color: #0a1930;
        box-sizing: border-box;
        color: white;
        display: flex;
        flex-direction: column;
        padding: 20px;
    }

    .logo {
        margin: 0 0 20px 0;
        font-size: 20px;
        font-weight: 700;
    }

    .nav-item {
        display: block;
        color: white;
        text-decoration: none;
        padding: 10px 12px;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: background-color 0.2s ease;
    }

        .nav-item:hover {
            background-color: rgba(255, 255, 255, 0.12);
        }

        .nav-item.active {
            background-color: rgba(255, 255, 255, 0.18);
            font-weight: 600;
        }

    .theme-toggle {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 15px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .theme-text {
        font-size: 14px;
        opacity: 0.9;
    }

    .btn-theme {
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }
</style>

@code {
    private bool IsDarkTheme;

    protected override void OnInitialized()
    {
        IsDarkTheme = Preferences.Get("dark_theme", false);
    }

    private async Task ToggleTheme()
    {
        IsDarkTheme = !IsDarkTheme;

        Preferences.Set("dark_theme", IsDarkTheme);

        await JS.InvokeVoidAsync("toggleTheme", IsDarkTheme);
    }
}
