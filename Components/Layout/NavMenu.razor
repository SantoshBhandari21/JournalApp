@inject IJSRuntime JS

<nav class="sidebar">
    <h2 class="logo">JournalApp</h2>

    <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
        Home
    </NavLink>

    <NavLink href="/journal" class="nav-item">
        Add Journal
    </NavLink>

    <NavLink href="/journals" class="nav-item">
        View Journal
    </NavLink>

    <NavLink href="/calendar" class="nav-item">
        Calendar
    </NavLink>

    <NavLink href="/settings" class="nav-item">
        Settings
    </NavLink>

    <!-- Theme toggle button -->
    <div class="theme-toggle">
        <span class="theme-text">Theme</span>

        <button class="btn-theme" type="button" @onclick="ToggleTheme">
            @(IsDarkTheme ? "Light" : "Dark")
        </button>
    </div>
</nav>

<style>
    .theme-toggle{
        margin-top: auto; /* pushes it to bottom */
        padding: 12px 10px;
        border-top: 1px solid rgba(255,255,255,0.10);
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:10px;
        color:#e5e7eb;
    }

    .theme-text{
        font-weight:700;
        font-size:14px;
        opacity:.9;
    }

    .btn-theme{
        padding: 6px 12px;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.25);
        background: rgba(255,255,255,0.12);
        color: #ffffff;
        font-size: 13px;
        cursor: pointer;
    }

    .btn-theme:hover{
        background: rgba(255,255,255,0.20);
    }

    /* SIDEBAR BACKGROUND */
    .sidebar {
        width: 220px;
        height: 100vh;
        background-color: #1f2937; /* dark gray / slate */
        padding: 20px;
        box-sizing: border-box;
        color: white;

        /* Required so theme toggle stays at bottom */
        display: flex;
        flex-direction: column;
    }

    /* APP TITLE */
    .logo {
        margin-bottom: 30px;
        font-size: 22px;
        font-weight: bold;
        color: #ffffff;
    }

    /* NAV LINKS */
    .nav-item {
        display: block;
        padding: 12px 14px;
        margin-bottom: 10px;
        color: #e5e7eb;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 500;
    }

    /* HOVER EFFECT */
    .nav-item:hover {
        background-color: #374151;
        color: #ffffff;
    }

    /* ACTIVE LINK */
    .nav-item.active {
        background-color: #4b5563;
        color: #ffffff;
    }
</style>

@code {
    private bool IsDarkTheme;

    protected override void OnInitialized()
    {
        IsDarkTheme = Preferences.Get("dark_theme", false);
    }

    private async Task ToggleTheme()
    {
        IsDarkTheme = !IsDarkTheme;
        Preferences.Set("dark_theme", IsDarkTheme);
        await JS.InvokeVoidAsync("toggleTheme", IsDarkTheme);
    }
}
