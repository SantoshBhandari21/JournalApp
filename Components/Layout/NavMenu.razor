@inject IJSRuntime JS

<!-- Main sidebar navigation -->
<nav class="sidebar">
    <h2 class="logo">JournalApp</h2>

    <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">Home</NavLink>
    <NavLink href="/journal" class="nav-item">Add Journal</NavLink>
    <NavLink href="/journals" class="nav-item">View Journal</NavLink>
    <NavLink href="/calendar" class="nav-item">Calendar</NavLink>
    <NavLink href="/settings" class="nav-item">Settings</NavLink>

    <!-- Theme option styled like a normal menu item -->
    <div class="nav-item theme-toggle">
        <span>Theme</span>
        <button class="theme-btn" type="button" @onclick="ToggleTheme">
            @(IsDarkTheme ? "Light" : "Dark")
        </button>
    </div>
</nav>

<style>
    /* Sidebar layout */
    .sidebar {
        width: 220px;
        height: 100vh;
        background-color: #0a1930;
        box-sizing: border-box;
        color: white;
        display: flex;
        flex-direction: column;
    }

    /* App title */
    .logo {
        margin-bottom: 30px;
        font-size: 22px;
        font-weight: bold;
        color: #ffffff;
    }

    /* Nav links */
    .nav-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        margin-bottom: 10px;
        color: #e5e7eb;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
    }

        .nav-item:hover {
            background-color: #13294b;
        }

        .nav-item.active {
            background-color: #1e3a8a;
            color: #ffffff;
        }

    /* Theme button inside menu row */
    .theme-btn {
        border: none;
        background: rgba(255,255,255,0.15);
        color: inherit;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

        .theme-btn:hover {
            background: rgba(255,255,255,0.25);
        }
</style>

@code {
    private bool IsDarkTheme;

    protected override void OnInitialized()
    {
        IsDarkTheme = Preferences.Get("dark_theme", false);
    }

    /* Toggles the saved theme and notifies the UI through JavaScript */
    private async Task ToggleTheme()
    {
        IsDarkTheme = !IsDarkTheme;
        Preferences.Set("dark_theme", IsDarkTheme);
        await JS.InvokeVoidAsync("toggleTheme", IsDarkTheme);
    }
}
