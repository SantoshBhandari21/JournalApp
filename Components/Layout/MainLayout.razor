@inherits LayoutComponentBase
@inject JournalApp.Services.ThemeService Theme

<style>
    .app-shell {
        display: flex;
        min-height: 100vh;
        background: var(--bg);
    }

    .content-area {
        flex: 1;
        padding: 16px;
    }

    /* Keep your pages nicely centered like before */
    .content-inner {
        max-width: 1100px;
        margin: 0 auto;
    }

    @@media (max-width: 820px) {
        .app-shell {
            flex-direction: column;
        }
    }
</style>

<div class="app-shell @(Theme.CurrentTheme == "dark" ? "theme-dark" : "")">
    <NavMenu />

    <main class="content-area">
        <div class="content-inner">
            @Body
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Theme.Load();
        Theme.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
    }
}
