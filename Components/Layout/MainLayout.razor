@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="layout">
    <NavMenu />

    <main class="content">
        @Body
    </main>
</div>

<style>
    /* Main layout structure and content area styling */
    .layout {
        display: flex;
        height: 100vh;
    }

    .content {
        flex: 1;
        padding: 30px;
        overflow-y: auto;
        background-color: #f9f9f9;
        transition: background-color 0.3s ease;
    }

    /* Light and dark theme background handling */
    body:not(.dark-theme) .content {
        background-color: #f9f9f9;
    }

    body.dark-theme .content {
        background-color: #0f172a;
    }

</style>

@code {
    /* Applying saved theme once when the app first loads */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var isDark = Preferences.Get("dark_theme", false);
        await JS.InvokeVoidAsync("toggleTheme", isDark);
    }
}
