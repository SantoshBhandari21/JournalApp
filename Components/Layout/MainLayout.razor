@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="layout">
    <NavMenu />

    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Apply saved theme ONCE at app startup
            var isDark = Preferences.Get("dark_theme", false);
            await JS.InvokeVoidAsync("toggleTheme", isDark);
        }
    }
}

<style>
    .layout {
        display: flex;
        height: 100vh;
    }

    .content {
        flex: 1;
        padding: 30px;
        overflow-y: auto;
        background-color: #f9f9f9;
        transition: background-color 0.3s ease;
    }

    /* Light theme (default) */
    body:not(.dark-theme) .content {
        background-color: #f9f9f9;
    }

    /* Dark theme */
    body.dark-theme .content {
        background-color: #0f172a;
    }
</style>